{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "manage": "powershell -ExecutionPolicy Bypass -File ./manage-app.ps1",
    "start": "node dist/server.cjs",
    "start:app": "powershell -ExecutionPolicy Bypass -File ./manage-app.ps1 start",
    "status:app": "powershell -ExecutionPolicy Bypass -File ./manage-app.ps1 status",
    "stop:app": "powershell -ExecutionPolicy Bypass -File ./manage-app.ps1 stop",
    "restart:app": "powershell -ExecutionPolicy Bypass -File ./manage-app.ps1 restart",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:prepare": "npm run build && node scripts/prepare-electron.js",
    "electron:build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.8.0",
    "ssh2": "^1.17.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "electron": "^34.1.1",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.linux-ai-ops.studio",
    "productName": "Linux AI Ops Studio",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**",
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-resources",
        "to": ".",
        "filter": ["**/*"]
      }
    ],
    "nodeGypRebuild": false,
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Linux AI Ops Studio"
    }
  }
}
