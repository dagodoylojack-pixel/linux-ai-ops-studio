# Linux AI Ops Studio - Plantilla de Configuración
# Copia este archivo a .env y rellena tus valores

# OpenRouter API Key (obtén una gratis en https://openrouter.ai/keys)
# Opcional: sin ella, la app funciona en modo simulado
# OPENROUTER_API_KEY=sk_or_your_api_key_here

# Modelo de IA a usar (default: openrouter/free)
# Opciones: openrouter/free, gpt-4-1-mini, claude-3-haiku, etc.
# OPENROUTER_MODEL=openrouter/free

# Base URL de OpenRouter (default: https://openrouter.ai/api/v1)
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Puerto donde corre el servidor (default: 3005)
# PORT=3005

# Ruta del archivo de credenciales SQLite (default: .linux_ai_ops.sqlite3)
# STORAGE_DB_PATH=.linux_ai_ops.sqlite3
